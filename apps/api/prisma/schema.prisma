generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Core: tenancy, auth, audit
// ─────────────────────────────────────────────────────────────

model Tenant {
  id                      String            @id @default(uuid()) @db.Uuid
  name                    String
  slug                    String            @unique
  nomeFantasia            String?
  logoUrl                 String?
  razaoSocial             String?
  cnpj                    String?
  inscricaoEstadual       String?
  inscricaoMunicipal      String?
  cnae                    String?
  regimeTributario        RegimeTributario?
  cep                     String?
  logradouro              String?
  numero                  String?
  complemento             String?
  bairro                  String?
  cidade                  String?
  uf                      String?
  representanteLegalNome  String?
  representanteLegalCpf   String?
  representanteLegalCargo String?
  createdAt               DateTime          @default(now())

  users                    User[]
  auditEvents              AuditEvent[]
  recruitmentJobs          RecruitmentJob[]
  candidates               Candidate[]
  candidatePoolEntries     CandidatePoolEntry[]
  jobRequisitions          JobRequisition[]
  scheduledInterviews      ScheduledInterview[]
  checklistItemDefs        ChecklistItemDef[]
  admissions               Admission[]
  employees                Employee[]
  evaluationCycles         EvaluationCycle[]
  evaluationRecords        EvaluationRecord[]
  goals                    Goal[]
  pdiActions               PdiAction[]
  vacationRequests         VacationRequest[]
  leaveRecords             LeaveRecord[]
  terminations             Termination[]
  terminationChecklistDefs TerminationChecklistDef[]
  documentTemplates        DocumentTemplate[]

  laborDeadlines          LaborDeadline[]
  collectiveAgreements    CollectiveAgreement[]
  jobGrades               JobGrade[]
  departments             Department[]
  beneficioTipos          BeneficioTipo[]
  coparticipacaoRegras    CoparticipacaoRegra[]
  conveniosAcademia       ConvenioAcademia[]
  planosSaude             PlanoSaude[]
  planoSaudeFaixasEtarias PlanoSaudeFaixaEtaria[]
  feriados                Feriado[]
  adesoesValeDiario       AdesaoValeDiario[]
  adesoesAcademia         AdesaoAcademia[]
  adesoesPlanoSaude       AdesaoPlanoSaude[]
  dependentesPlanoSaude   DependentePlanoSaude[]
  adesoesBeneficioFixo    AdesaoBeneficioFixo[]
  apuracoesBeneficios     ApuracaoBeneficio[]
  equipmentItems          EquipmentItem[]
  timeJustifications      TimeJustification[]
  payrollRuns             PayrollRun[]
  payslipItems            PayslipItem[]
  payrollGuides           PayrollGuide[]
  payrollLineItems        PayrollLineItem[]
  payrollImportBatches    PayrollImportBatch[]
  payrollImportTemplates  PayrollImportTemplate[]

  agendaItems           AgendaItem[]
  agendaDismissals      AgendaDismissal[]
  notepadEntries        NotepadEntry[]
  agendaCategorias      AgendaCategoria[]
  agendaRecorrencias    AgendaRecorrencia[]
  agendaComentarios     AgendaComentario[]
  agendaRevisoesDiarias AgendaRevisaoDiaria[]
  agendaLembretes       AgendaLembrete[]
  agendaNotificacoes    AgendaNotificacao[]
  projetos              Projeto[]
  projetoParticipantes  ProjetoParticipante[]
  projetoMarcos         ProjetoMarco[]
  projetoModelos        ProjetoModelo[]
  agendaItemSubtarefas  AgendaItemSubtarefa[]

  accidents         Accident[]
  occupationalExams OccupationalExam[]
  nrTrainingRecords NrTrainingRecord[]
  pgrActions        PgrAction[]
  riskMapEntries    RiskMapEntry[]
  sstSettings       SstSettings?
  ocorrencias       Ocorrencia[]

  documentRequirements DocumentRequirement[]
  tasks                Task[]
  tarefasDoDiaFixacoes TarefaDoDiaFixacao[]
  periodosAquisitivos  PeriodoAquisitivo[]
  fracoesDeFerias      FracaoDeFerias[]
  faltasInjustificadas FaltaInjustificada[]
  jornadas             Jornada[]
  batidas              Batida[]
  ajustesPonto         AjustePonto[]
  certificadosDigitais CertificadoDigital[]
  afdGeracoes          AfdGeracao[]
  license              TenantLicense?

  ethicsCases            EthicsCase[]
  compliancePolicies     CompliancePolicy[]
  eloConversations       EloConversation[]
  integrationConnections IntegrationConnection[]
  announcements          Announcement[]
  metricSnapshots        MetricSnapshot[]
  atalhosExternos        AtalhoExterno[]

  riskImpactRules              RiskImpactRule[]

  metasPessoais               MetaPessoal[]
  habitosPessoais             HabitoPessoal[]
  habitoPessoalRegistros      HabitoPessoalRegistro[]
  financasPessoaisCategorias  FinancaPessoalCategoria[]
  financasPessoaisLancamentos FinancaPessoalLancamento[]
  humorRegistros              HumorRegistro[]
  cicloMenstrualRegistros     CicloMenstrualRegistro[]
  pesoMedidaRegistros         PesoMedidaRegistro[]
  rodaDaVidaAvaliacoes        RodaDaVidaAvaliacao[]
  revisoesMensais             RevisaoMensal[]
  melhorEuPossivelRegistros   MelhorEuPossivelRegistro[]
  ikigaiAvaliacoes            IkigaiAvaliacao[]
  swotPessoalRegistros        SwotPessoalRegistro[]

  @@map("tenants")
}

enum Role {
  ADMIN
  RH_GENERALISTA
  GESTOR_AREA
  COLABORADOR
  COMPLIANCE
  COMITE_ETICA
  PSICOLOGIA

  @@map("role")
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  email            String
  passwordHash     String
  name             String
  role             Role      @default(COLABORADOR)
  employeeId       String?   @db.Uuid
  mfaEnabled       Boolean   @default(true)
  mfaCodeHash      String?
  mfaCodeExpiresAt DateTime?
  mfaAttempts      Int       @default(0)
  createdAt        DateTime  @default(now())

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee       Employee?       @relation(fields: [employeeId], references: [id])
  trustedDevices TrustedDevice[]

  @@unique([tenantId, email])
  @@map("users")
}

// Um dispositivo/navegador que já passou pelo código de verificação por
// e-mail uma vez não precisa passar de novo até o token expirar — mesmo
// padrão de "lembrar este dispositivo" usado por Google/etc. O token cru só
// existe no cookie do navegador; aqui fica só o hash (mesmo esquema do
// PasswordResetToken), então um vazamento do banco não permite reconstruir
// cookies válidos.
model TrustedDevice {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("trusted_devices")
}

// Cross-tenant on purpose — brute-force protection has to see attempts
// regardless of which tenant is being targeted, and runs before any tenant
// context exists (login is the one write path that predates auth). Not
// RLS-scoped; not reachable through PrismaService.forCurrentTenant().
model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

// Cross-tenant like LoginAttempt — tied to userId, not RLS-scoped.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  actorId    String?  @db.Uuid
  actorName  String
  entityType String
  entityId   String
  action     String
  payload    Json?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityType, entityId])
  @@map("audit_events")
}

// ─────────────────────────────────────────────────────────────
// Recrutamento & Seleção
// ─────────────────────────────────────────────────────────────

enum JobContrato {
  CLT
  ESTAGIO
  PJ
  INTERMITENTE

  @@map("job_contrato")
}

enum TipoSalario {
  MENSALISTA
  HORISTA
  DIARISTA

  @@map("tipo_salario")
}

enum RegimeTributario {
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL

  @@map("regime_tributario")
}

enum JobStatus {
  ABERTA
  EM_ANALISE
  ENCERRADA

  @@map("job_status")
}

model RecruitmentJob {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @db.Uuid
  cargo     String
  depto     String
  contrato  JobContrato @default(CLT)
  status    JobStatus   @default(ABERTA)
  createdAt DateTime    @default(now())

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  candidates          Candidate[]
  costs               JobCost[]
  scheduledInterviews ScheduledInterview[]

  @@index([tenantId])
  @@map("recruitment_jobs")
}

enum CandidateStage {
  TRIAGEM
  ENTREVISTA
  PROPOSTA
  CONTRATADO
  REPROVADO

  @@map("candidate_stage")
}

model Candidate {
  id               String         @id @default(uuid()) @db.Uuid
  tenantId         String         @db.Uuid
  jobId            String         @db.Uuid
  nome             String
  origem           String?
  stage            CandidateStage @default(TRIAGEM)
  email            String?
  telefone         String?
  resumo           String?
  notas            String?
  scoreComunicacao Int            @default(3)
  scoreTecnica     Int            @default(3)
  scoreCultura     Int            @default(3)
  createdAt        DateTime       @default(now())

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  job                 RecruitmentJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  scheduledInterviews ScheduledInterview[]

  @@index([tenantId, jobId])
  @@map("candidates")
}

enum CandidatePoolType {
  TALENT_BANK
  BLOCKED

  @@map("candidate_pool_type")
}

model CandidatePoolEntry {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @db.Uuid
  type         CandidatePoolType
  nome         String
  perfil       String?
  vagaAnterior String?
  motivo       String?
  createdAt    DateTime          @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, type])
  @@map("candidate_pool_entries")
}

model JobCost {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  jobId     String   @db.Uuid
  categoria String
  descricao String?
  valor     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  job RecruitmentJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([tenantId, jobId])
  @@map("job_costs")
}

enum RequisitionStatus {
  PENDENTE
  APROVADA
  RECUSADA

  @@map("requisition_status")
}

model JobRequisition {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @db.Uuid
  cargo         String
  solicitante   String
  depto         String
  contrato      JobContrato       @default(CLT)
  faixaSalarial Decimal?          @db.Decimal(12, 2)
  prioridade    String            @default("Normal")
  status        RequisitionStatus @default(PENDENTE)
  respondidoEm  DateTime?
  createdAt     DateTime          @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("job_requisitions")
}

model ScheduledInterview {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  jobId       String   @db.Uuid
  candidateId String   @db.Uuid
  dataLabel   String
  hora        String
  createdAt   DateTime @default(now())

  job       RecruitmentJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  tenant    Tenant         @relation(fields: [tenantId], references: [id])

  @@index([tenantId, jobId])
  @@map("scheduled_interviews")
}

// ─────────────────────────────────────────────────────────────
// Admissão
// ─────────────────────────────────────────────────────────────

enum ChecklistScope {
  ADMISSAO
  DESLIGAMENTO

  @@map("checklist_scope")
}

model ChecklistItemDef {
  id       String         @id @default(uuid()) @db.Uuid
  tenantId String         @db.Uuid
  scope    ChecklistScope @default(ADMISSAO)
  filial   String?
  key      String
  nome     String
  ativo    Boolean        @default(true)
  ordem    Int            @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, scope, filial, key])
  @@map("checklist_item_defs")
}

enum AdmissionStatus {
  PENDENTE_DOCUMENTO
  AGUARDANDO_EXAME
  PRONTO_PARA_EFETIVAR
  EFETIVADO

  @@map("admission_status")
}

model Admission {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @db.Uuid
  nome             String
  cargo            String
  filial           String
  dataInicio       DateTime        @db.Date
  status           AdmissionStatus @default(PENDENTE_DOCUMENTO)
  origemVaga       String?
  salario          Decimal         @db.Decimal(12, 2)
  docs             Json            @default("{}")
  esocialSent      Boolean         @default(false)
  contratoGerado   Boolean         @default(false)
  contratoAssinado Boolean         @default(false)
  employeeId       String?         @db.Uuid
  createdAt        DateTime        @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
  @@map("admissions")
}

// ─────────────────────────────────────────────────────────────
// Colaboradores
// ─────────────────────────────────────────────────────────────

enum EmployeeStatus {
  ATIVO
  INATIVO

  @@map("employee_status")
}

enum CnhCategoria {
  A
  B
  AB
  C
  AC
  D
  AD
  E
  AE

  @@map("cnh_categoria")
}

enum TipoContaBancaria {
  CORRENTE
  POUPANCA

  @@map("tipo_conta_bancaria")
}

model Employee {
  id                     String             @id @default(uuid()) @db.Uuid
  tenantId               String             @db.Uuid
  matricula              String
  nome                   String
  cargo                  String
  departamento           String
  filial                 String?
  gestorDireto           String?
  status                 EmployeeStatus     @default(ATIVO)
  dataAdmissao           DateTime           @db.Date
  email                  String?
  telefone               String?
  endereco               String?
  cpf                    String?
  rg                     String?
  rgOrgaoExpedidor       String?
  rgDataExpedicao        DateTime?          @db.Date
  dataNascimento         DateTime?          @db.Date
  nacionalidade          String?
  estadoCivil            String?
  nomeMae                String?
  nomePai                String?
  pis                    String?
  ctps                   String?
  tituloEleitor          String?
  tituloEleitorZona      String?
  tituloEleitorSecao     String?
  genero                 String?
  escolaridade           String?
  cnh                    String?
  cnhCategoria           CnhCategoria?
  cnhValidade            DateTime?          @db.Date
  conjugeNome            String?
  conjugeCpf             String?
  pcd                    Boolean            @default(false)
  semDependentes         Boolean            @default(false)
  racaCor                String?
  salario                Decimal            @db.Decimal(12, 2)
  banco                  String?
  agencia                String?
  conta                  String?
  tipoConta              TipoContaBancaria?
  chavePix               String?
  tipoContrato           JobContrato        @default(CLT)
  tipoSalario            TipoSalario        @default(MENSALISTA)
  feriasSaldo            Int                @default(30)
  feriasVencimento       DateTime           @db.Date
  conformidadeDocumental Int                @default(0)
  createdAt              DateTime           @default(now())

  tenant                Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users                 User[]
  dependentes           Dependente[]
  contatosEmergencia    ContatoEmergencia[]
  historico             HistoricoEvento[]
  cargoSalarioHistorico CargoSalarioHistorico[]
  documentos            EmployeeDocumento[]
  documentRequirements  EmployeeDocumentRequirement[]
  feriasHistorico       FeriasHistorico[]
  admissions            Admission[]
  evaluationRecords     EvaluationRecord[]
  goals                 Goal[]
  pdiActions            PdiAction[]
  vacationRequests      VacationRequest[]
  leaveRecords          LeaveRecord[]
  terminations          Termination[]
  periodosAquisitivos   PeriodoAquisitivo[]
  faltasInjustificadas  FaltaInjustificada[]
  jornadas              Jornada[]
  batidas               Batida[]
  ajustesPonto          AjustePonto[]

  adesoesValeDiario    AdesaoValeDiario[]
  adesoesAcademia      AdesaoAcademia[]
  adesoesPlanoSaude    AdesaoPlanoSaude[]
  adesoesBeneficioFixo AdesaoBeneficioFixo[]
  apuracoesBeneficios  ApuracaoBeneficio[]
  equipmentItems       EquipmentItem[]
  timeJustifications   TimeJustification[]
  payslipItems         PayslipItem[]

  accidents         Accident[]
  occupationalExams OccupationalExam[]
  nrTrainingRecords NrTrainingRecord[]
  ocorrencias       Ocorrencia[]

  policyAcknowledgments PolicyAcknowledgment[]

  @@unique([tenantId, matricula])
  @@index([tenantId])
  @@map("employees")
}

model Dependente {
  id             String    @id @default(uuid()) @db.Uuid
  employeeId     String    @db.Uuid
  nome           String
  parentesco     String
  cpf            String?
  dataNascimento DateTime? @db.Date

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("dependentes")
}

model ContatoEmergencia {
  id         String    @id @default(uuid()) @db.Uuid
  employeeId String    @db.Uuid
  nome       String
  parentesco String
  telefone   String?
  deletedAt  DateTime?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("contatos_emergencia")
}

model HistoricoEvento {
  id           String   @id @default(uuid()) @db.Uuid
  employeeId   String   @db.Uuid
  evento       String
  categoria    String
  autor        String
  data         DateTime @default(now())
  // Presentes só em eventos de exclusão de um registro revertível — é o que
  // permite o botão "Reverter" na tela de histórico. Sem relação formal com
  // @relation porque entidadeTipo varia entre várias tabelas diferentes.
  entidadeTipo String?
  entidadeId   String?  @db.Uuid

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("historico_eventos")
}

model EmployeeDocumento {
  id                String    @id @default(uuid()) @db.Uuid
  employeeId        String    @db.Uuid
  terminationId     String?   @db.Uuid
  ocorrenciaId      String?   @db.Uuid
  vacationRequestId String?   @db.Uuid
  leaveRecordId     String?   @db.Uuid
  fracaoDeFeriasId  String?   @db.Uuid
  nome              String
  tipo              String
  tamanho           String
  blobPathname      String?
  contentType       String?
  uploadEm          DateTime  @default(now())
  deletedAt         DateTime?

  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  termination     Termination?     @relation(fields: [terminationId], references: [id], onDelete: SetNull)
  ocorrencia      Ocorrencia?      @relation(fields: [ocorrenciaId], references: [id], onDelete: SetNull)
  vacationRequest VacationRequest? @relation(fields: [vacationRequestId], references: [id], onDelete: SetNull)
  leaveRecord     LeaveRecord?     @relation(fields: [leaveRecordId], references: [id], onDelete: SetNull)
  fracaoDeFerias  FracaoDeFerias?  @relation(fields: [fracaoDeFeriasId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([terminationId])
  @@index([ocorrenciaId])
  @@index([vacationRequestId])
  @@index([leaveRecordId])
  @@index([fracaoDeFeriasId])
  @@map("employee_documentos")
}

model Ocorrencia {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  employeeId String    @db.Uuid
  tipo       String
  data       DateTime  @db.Date
  descricao  String
  autor      String
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee   Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  documentos EmployeeDocumento[]

  @@index([tenantId, employeeId])
  @@map("ocorrencias")
}

model CargoSalarioHistorico {
  id            String    @id @default(uuid()) @db.Uuid
  employeeId    String    @db.Uuid
  vigenciaDesde DateTime  @db.Date
  cargo         String
  salario       Decimal   @db.Decimal(12, 2)
  motivo        String
  observacao    String?
  registradoEm  DateTime  @default(now())
  registradoPor String
  deletedAt     DateTime?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("cargo_salario_historico")
}

model FeriasHistorico {
  id         String @id @default(uuid()) @db.Uuid
  employeeId String @db.Uuid
  periodo    String
  dias       Int

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("ferias_historico")
}

// ─────────────────────────────────────────────────────────────
// Avaliação e PDI
// ─────────────────────────────────────────────────────────────

enum EvaluationModel {
  NOVENTA
  CENTO_OITENTA
  TRESSESSENTA

  @@map("evaluation_model")
}

model EvaluationCycle {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @db.Uuid
  nome          String
  periodoInicio DateTime        @db.Date
  periodoFim    DateTime        @db.Date
  modelo        EvaluationModel @default(NOVENTA)
  createdAt     DateTime        @default(now())

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  records EvaluationRecord[]
  goals   Goal[]

  @@index([tenantId])
  @@map("evaluation_cycles")
}

model EvaluationRecord {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  cycleId    String   @db.Uuid
  employeeId String   @db.Uuid
  autoNota   Decimal? @db.Decimal(3, 1)
  gestorNota Decimal? @db.Decimal(3, 1)

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cycle    EvaluationCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([cycleId, employeeId])
  @@index([tenantId])
  @@map("evaluation_records")
}

enum GoalStatus {
  EM_ANDAMENTO
  CONCLUIDA

  @@map("goal_status")
}

model Goal {
  id         String     @id @default(uuid()) @db.Uuid
  tenantId   String     @db.Uuid
  cycleId    String     @db.Uuid
  employeeId String     @db.Uuid
  texto      String
  status     GoalStatus @default(EM_ANDAMENTO)
  createdAt  DateTime   @default(now())

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cycle    EvaluationCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, cycleId])
  @@map("goals")
}

model PdiAction {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  employeeId String   @db.Uuid
  texto      String
  prazo      DateTime @db.Date
  done       Boolean  @default(false)
  createdAt  DateTime @default(now())

