  ENTRADA
  SAIDA
  INTERVALO_INICIO
  INTERVALO_FIM

  @@map("tipo_batida")
}

enum OrigemBatida {
  APP
  WEB
  MANUAL_RH

  @@map("origem_batida")
}

enum TipoAjustePonto {
  OMISSAO
  CORRECAO_HORARIO
  ABONO

  @@map("tipo_ajuste_ponto")
}

enum StatusAjustePonto {
  PENDENTE
  APROVADA
  REPROVADA

  @@map("status_ajuste_ponto")
}

/// Jornada esperada de um colaborador -- vigência permite trocar de escala sem apagar histórico.
model Jornada {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  employeeId        String    @db.Uuid
  diasSemana        Int[] // 0=domingo .. 6=sábado
  entrada           String // "HH:mm"
  saida             String // "HH:mm"
  intervaloInicio   String? // "HH:mm"
  intervaloFim      String? // "HH:mm"
  toleranciaMinutos Int       @default(5)
  vigenciaDesde     DateTime  @db.Date
  vigenciaAte       DateTime? @db.Date
  createdAt         DateTime  @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId])
  @@map("jornadas")
}

/// Marcação de ponto -- imutável (nunca editada/apagada após criada). Correções
/// entram como AjustePonto separado, nunca alterando o registro original (Portaria
/// 671/2021, art. 82 §único: PTRP só complementa omissão, nunca muda o horário real).
model Batida {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @db.Uuid
  employeeId      String       @db.Uuid
  dataHora        DateTime
  tipo            TipoBatida
  origem          OrigemBatida
  latitude        Decimal?     @db.Decimal(9, 6)
  longitude       Decimal?     @db.Decimal(9, 6)
  nsr             Int // sequencial por tenant, nunca reaproveitado (Portaria 671/2021)
  registradoPorId String?      @db.Uuid
  createdAt       DateTime     @default(now())

  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee          Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  ajustesComoOrigem AjustePonto[] @relation("BatidaOrigemAjuste")

  @@unique([tenantId, nsr])
  @@index([tenantId, employeeId, dataHora])
  @@map("batidas")
}

/// Solicitação de ajuste (omissão, correção de horário ou abono) -- nunca altera
/// a Batida original, só complementa o cálculo do espelho quando aprovada.
model AjustePonto {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @db.Uuid
  employeeId      String            @db.Uuid
  data            DateTime          @db.Date
  tipoAjuste      TipoAjustePonto
  horarioProposto DateTime?
  batidaOrigemId  String?           @db.Uuid
  justificativa   String
  status          StatusAjustePonto @default(PENDENTE)
  solicitadoPorId String?           @db.Uuid
  aprovadoPorId   String?           @db.Uuid
  dataAprovacao   DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  batidaOrigem Batida?  @relation("BatidaOrigemAjuste", fields: [batidaOrigemId], references: [id], onDelete: SetNull)

  @@index([tenantId, employeeId])
  @@map("ajustes_ponto")
}

/// Certificado ICP-Brasil (e-CNPJ) do tenant, usado pra assinar AFD (CAdES) e
/// comprovante de marcação (PAdES). Nunca exposto via endpoint de download --
/// só lido server-side no momento de assinar. Senha nunca em texto puro (ver
/// common/secret-vault.util.ts).
model CertificadoDigital {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @db.Uuid
  blobPathname       String
  senhaCriptografada String
  titular            String
  validade           DateTime @db.Date
  uploadEm           DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("certificados_digitais")
}

/// Trilha de auditoria de cada AFD assinado gerado -- nunca regenerado
/// silenciosamente, cada geração é um novo registro imutável.
model AfdGeracao {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  periodoInicio DateTime @db.Date
  periodoFim    DateTime @db.Date
  blobPathname  String
  hash          String
  nsrInicial    Int
  nsrFinal      Int
  geradoPorId   String?  @db.Uuid
  geradoEm      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("afd_geracoes")
}

enum PayrollRunStatus {
  ABERTO
  PROCESSADA

  @@map("payroll_run_status")
}

model PayrollRun {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  competencia String // "2026-07"
  status      PayrollRunStatus @default(ABERTO)
  esocialSent Boolean          @default(false)
  processedAt DateTime?
  createdAt   DateTime         @default(now())

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items         PayslipItem[]
  guides        PayrollGuide[]
  importBatches PayrollImportBatch[]

  @@unique([tenantId, competencia])
  @@index([tenantId])
