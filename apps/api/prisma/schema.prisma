/**
 * Check-in diário de humor — dado sensível (saúde/bem-estar), visível só para o próprio usuário.
 */
model HumorRegistro {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  data      DateTime @db.Date
  nivel     Int
  nota      String?
  // "Três Coisas Boas" (Seligman) — gratidão diária, a intervenção de psicologia positiva mais validada.
  gratidao1 String?
  gratidao2 String?
  gratidao3 String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, data])
  @@map("humor_registros")
}

/**
 * Registro de ciclo menstrual — dado sensível de saúde (LGPD art. 5º II), visível só para o próprio usuário.
 */
model CicloMenstrualRegistro {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  userId      String   @db.Uuid
  dataInicio  DateTime @db.Date
  duracaoDias Int?
  sintomas    String?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("ciclo_menstrual_registros")
}

/**
 * Peso e medidas corporais — dado sensível de saúde, visível só para o próprio usuário.
 */
model PesoMedidaRegistro {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  data      DateTime @db.Date
  pesoKg    Decimal? @db.Decimal(5, 2)
  alturaCm  Decimal? @db.Decimal(5, 2)
  cinturaCm Decimal? @db.Decimal(5, 2)
  quadrilCm Decimal? @db.Decimal(5, 2)
  bracoCm   Decimal? @db.Decimal(5, 2)
  aguaMl    Int?
  notas     String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, data])
  @@map("peso_medida_registros")
}

/**
 * Roda da vida — autoavaliação de satisfação (1-10) em 8 áreas clássicas da ferramenta de coaching. Refeita quando o usuário quiser, pra comparar evolução ao longo do ano.
 */
model RodaDaVidaAvaliacao {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @db.Uuid
  userId             String   @db.Uuid
  data               DateTime @db.Date
  carreira           Int
  financas           Int
  saude              Int
  familiaAmigos      Int
  relacionamento     Int
  crescimentoPessoal Int
  lazer              Int
  ambienteFisico     Int
  createdAt          DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, data])
  @@map("roda_da_vida_avaliacoes")
}

/**
 * Revisão mensal — intenções no início do mês e reflexão guiada no fim (o que funcionou / o que não funcionou / o que precisa mudar).
 */
/**
 * Início do mês segue o método WOOP (Wish/Outcome/Obstacle/Plan — Oettingen &
 * Gollwitzer): desejo, resultado vívido, obstáculo interno e um plano
 * "se-então" (implementation intention). Fim do mês é reflexão guiada:
 * satisfação, conquistas, o que não funcionou (sem autojulgamento) e um
 * único próximo passo — listas grandes de "o que mudar" reduzem adesão.
 */
model RevisaoMensal {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  userId           String   @db.Uuid
  ano              Int
  mes              Int
  desejo           String?
  resultado        String?
  obstaculo        String?
  plano            String?
  satisfacao       Int?
  conquistas       String?
  oQueNaoFuncionou String?
  proximoPasso     String?
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, ano, mes])
  @@map("revisoes_mensais")
}

/**
 * Melhor Eu Possível — escrita periódica sobre o futuro ideal (uma das intervenções de psicologia positiva mais validadas). Refeita quando o usuário quiser.
 */
model MelhorEuPossivelRegistro {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  data      DateTime @db.Date
  texto     String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, data])
  @@map("melhor_eu_possivel_registros")
}

/**
 * Ikigai — interseção entre o que ama, no que é bom, do que o mundo precisa e pelo que pode ser pago.
 */
model IkigaiAvaliacao {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @db.Uuid
  userId             String   @db.Uuid
  data               DateTime @db.Date
  oQueAma            String?
  noQueEBom          String?
  oMundoPrecisa      String?
  peloQuePodeSerPago String?
  sintese            String?
  createdAt          DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, data])
  @@map("ikigai_avaliacoes")
}

/**
 * SWOT pessoal — Forças, Fraquezas, Oportunidades e Ameaças aplicado a si mesmo.
 */
model SwotPessoalRegistro {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  userId        String   @db.Uuid
  data          DateTime @db.Date
  forcas        String?
  fraquezas     String?
  oportunidades String?
  ameacas       String?
  createdAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, data])
  @@map("swot_pessoal_registros")
}

// ─────────────────────────────────────────────────────────────
// Histórico de métricas — captura diária para permitir comparações
// reais ("vs. mês anterior") no painel, sem inventar números.
// ─────────────────────────────────────────────────────────────

model MetricSnapshot {
  id       String   @id @default(uuid()) @db.Uuid
  tenantId String   @db.Uuid
  metrica  String
  valor    Decimal  @db.Decimal(10, 2)
  data     DateTime @db.Date

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, metrica, data])
  @@index([tenantId, metrica, data])
  @@map("metric_snapshots")
}
