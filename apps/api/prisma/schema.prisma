}

enum PayrollLineItemTipo {
  PROVENTO
  DESCONTO
  INFORMATIVO

  @@map("payroll_line_item_tipo")
}

model PayrollLineItem {
  id            String              @id @default(uuid()) @db.Uuid
  tenantId      String              @db.Uuid
  payslipItemId String              @db.Uuid
  codigo        String?
  descricao     String
  tipo          PayrollLineItemTipo
  valor         Decimal             @db.Decimal(12, 2)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payslipItem PayslipItem @relation(fields: [payslipItemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([payslipItemId])
  @@map("payroll_line_items")
}

model PayrollImportBatch {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  payrollRunId     String   @db.Uuid
  arquivoNome      String
  linhasTotal      Int
  linhasImportadas Int
  linhasComErro    Int
  erros            Json?
  importadoPor     String
  createdAt        DateTime @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("payroll_import_batches")
}

model PayrollImportTemplate {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  nome       String
  mapeamento Json
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, nome])
  @@index([tenantId])
  @@map("payroll_import_templates")
}

enum PayrollGuideStatus {
  PENDENTE
  GERADA

  @@map("payroll_guide_status")
}

model PayrollGuide {
  id           String             @id @default(uuid()) @db.Uuid
  tenantId     String             @db.Uuid
  payrollRunId String             @db.Uuid
  guia         String
  status       PayrollGuideStatus @default(PENDENTE)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("payroll_guides")
}

// ─────────────────────────────────────────────────────────────
// Área de trabalho: agenda do dia + bloco de notas com IA
// ─────────────────────────────────────────────────────────────

enum AgendaItemTipo {
  REUNIAO
  PRAZO
  TAREFA
  PESSOAL
  LEMBRETE

  @@map("agenda_item_tipo")
}

/// Categoria de cor livre para itens de agenda (RH-Legal/Prazo, RH-Rotina,
/// Pessoal/Equipe, Anotação/Lembrete) — as 4 são semeadas por tenant em
/// AuthService.provisionNewTenant e na migration de dados que criou a
/// tabela; `sistema=true` marca as categorias-padrão (não removíveis).
model AgendaCategoria {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  nome      String
  cor       String
  corDark   String
  icone     String
  ordem     Int      @default(0)
  sistema   Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  itens  AgendaItem[]

  @@index([tenantId])
  @@map("agenda_categorias")
}

model AgendaItem {
  id             String                @id @default(uuid()) @db.Uuid
  tenantId       String                @db.Uuid
  userId         String                @db.Uuid
  /// Coluna solta, sem relação Prisma para User (mesmo padrão de AuditEvent.actorId) — quem vê/edita o item passa a ser userId OU responsavelId, ver AgendaService.meuOuAtribuido.
  responsavelId  String?               @db.Uuid
  data           DateTime              @db.Date
  hora           String?
  horaFim        String?
  descricao      String
  notas          String?
  tipo           AgendaItemTipo        @default(TAREFA)
  categoriaId    String?               @db.Uuid
  recorrenciaId  String?               @db.Uuid
  projetoId      String?               @db.Uuid
  statusProjeto  TarefaProjetoStatus   @default(A_FAZER)
  prioridade     AgendaItemPrioridade?
  /// Dependência simples (1 nível, não é grafo): esta tarefa só devia avançar depois que a tarefa referenciada for concluída. Sem checagem de ciclo -- uso interno do Kanban de projeto, não é motor de agendamento.
  bloqueadoPorId String?               @db.Uuid
  concluida      Boolean               @default(false)
  origem         String                @default("MANUAL")
  createdAt      DateTime              @default(now())
  deletedAt      DateTime?

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoria    AgendaCategoria?      @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  recorrencia  AgendaRecorrencia?    @relation(fields: [recorrenciaId], references: [id], onDelete: SetNull)
  projeto      Projeto?              @relation(fields: [projetoId], references: [id], onDelete: SetNull)
  bloqueadoPor AgendaItem?           @relation("AgendaItemBloqueio", fields: [bloqueadoPorId], references: [id], onDelete: SetNull)
  bloqueia     AgendaItem[]          @relation("AgendaItemBloqueio")
  comentarios  AgendaComentario[]
  lembretes    AgendaLembrete[]
  subtarefas   AgendaItemSubtarefa[]

  @@index([tenantId, userId, data])
  @@index([recorrenciaId])
  @@index([responsavelId])
  @@index([projetoId])
  @@index([bloqueadoPorId])
  @@map("agenda_items")
}

enum AgendaItemPrioridade {
  P0
  P1
  P2
  P3

  @@map("agenda_item_prioridade")
}

enum TarefaProjetoStatus {
  A_FAZER
  EM_ANDAMENTO
  CONCLUIDA
}

/**
 * Checklist simples dentro de uma tarefa (AgendaItem) — ordem só controla exibição, sem drag-and-drop de reordenação por ora.
 */
model AgendaItemSubtarefa {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  agendaItemId String   @db.Uuid
  titulo       String
  concluida    Boolean  @default(false)
  ordem        Int      @default(0)
  createdAt    DateTime @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agendaItem AgendaItem @relation(fields: [agendaItemId], references: [id], onDelete: Cascade)

  @@index([agendaItemId])
  @@map("agenda_item_subtarefas")
}

enum ProjetoStatus {
  PLANEJADO
  EM_ANDAMENTO
  CONCLUIDO
  EM_RISCO
  CANCELADO
}

/**
 * Projeto compartilhado entre participantes (mesma equipe ou de equipes diferentes) — tarefas ficam em AgendaItem.projetoId, visíveis a todo participante.
 */
model Projeto {
  id                   String        @id @default(uuid()) @db.Uuid
  tenantId             String        @db.Uuid
  nome                 String
  descricao            String?
  dataInicio           DateTime      @db.Date
  dataFim              DateTime?     @db.Date
  status               ProjetoStatus @default(PLANEJADO)
  cor                  String        @default("#3b82f6")
  /// Limite de WIP (soft, só visual) da coluna "Em andamento" do Kanban -- null = sem limite definido.
  wipLimiteEmAndamento Int?
  criadoPorId          String        @db.Uuid
  createdAt            DateTime      @default(now())

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  participantes ProjetoParticipante[]
  tarefas       AgendaItem[]
  marcos        ProjetoMarco[]

  @@index([tenantId])
  @@map("projetos")
}

/**
 * Data-chave do projeto (ex.: "entrega da fase 1"), separada das tarefas do dia a dia.
 */
model ProjetoMarco {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  projetoId String   @db.Uuid
  titulo    String
  data      DateTime @db.Date
  concluido Boolean  @default(false)
  ordem     Int      @default(0)
  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projeto Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@index([projetoId])
  @@map("projeto_marcos")
}

/**
 * Modelo reutilizável de projeto — tarefas/marcos guardados como offset de dias em relação ao início, para gerar datas ao criar um projeto novo a partir do modelo. Json simples (em vez de tabelas próprias) por serem listas pequenas, só lidas/escritas inteiras.
 */
model ProjetoModelo {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  nome        String
  descricao   String?
  cor         String   @default("#3b82f6")
  criadoPorId String   @db.Uuid
  tarefas     Json     @default("[]")
  marcos      Json     @default("[]")
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("projeto_modelos")
}

model ProjetoParticipante {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  projetoId String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projeto Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@unique([projetoId, userId])
  @@index([tenantId, userId])
  @@map("projeto_participantes")
}

/// Comentários simples, append-only (sem edição/exclusão) — mesmo padrão de Ocorrencia (rh/employees): autor gravado como snapshot de nome, sem depender de join.
model AgendaComentario {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  agendaItemId String   @db.Uuid
  userId       String   @db.Uuid
  autor        String
  texto        String
  createdAt    DateTime @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agendaItem AgendaItem @relation(fields: [agendaItemId], references: [id], onDelete: Cascade)

  @@index([tenantId, agendaItemId])
  @@map("agenda_comentarios")
}

/// Regra de lembrete de um item de agenda — o sino (AgendaNotificacao) é
/// sempre criado quando dispara; notificarEmail liga um envio extra por
/// e-mail. Disparo via LembretesCronService (varredura diária), não por
/// request — ver agenda/lembretes-cron.service.ts.
model AgendaLembrete {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  agendaItemId     String   @db.Uuid
  userId           String   @db.Uuid
  antecedenciaDias Int
  notificarEmail   Boolean  @default(false)
  enviado          Boolean  @default(false)
  createdAt        DateTime @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agendaItem AgendaItem @relation(fields: [agendaItemId], references: [id], onDelete: Cascade)

  @@index([tenantId, enviado])
  @@map("agenda_lembretes")
}

/// Notificação por usuário exibida no sino do sistema (components/header.tsx
/// no frontend). agendaItemId é solto (sem FK Prisma, mesmo padrão de
/// AuditEvent.actorId) — se o item for excluído, a notificação permanece
/// como histórico.
model AgendaNotificacao {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  userId       String   @db.Uuid
  agendaItemId String?  @db.Uuid
  titulo       String
  lida         Boolean  @default(false)
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, lida])
  @@map("agenda_notificacoes")
}

enum AgendaRecorrenciaFrequencia {
  DIARIA
  SEMANAL
  MENSAL
  ANUAL
  PERSONALIZADA

  @@map("agenda_recorrencia_frequencia")
}

/// Regra de repetição materializada como várias linhas AgendaItem (mesma
/// recorrenciaId), não expandida em tempo de consulta — ver plano da Fase 2.
/// dataFim é obrigatória (o form sempre preenche, no máximo +2 anos) para
/// limitar o tamanho da série.
model AgendaRecorrencia {
  id           String                      @id @default(uuid()) @db.Uuid
  tenantId     String                      @db.Uuid
  userId       String                      @db.Uuid
  frequencia   AgendaRecorrenciaFrequencia
  intervalo    Int                         @default(1)
  diasDaSemana String[]                    @default([])
  posicaoNoMes Int?
  dataInicio   DateTime                    @db.Date
  dataFim      DateTime                    @db.Date
  createdAt    DateTime                    @default(now())

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  itens  AgendaItem[]

  @@index([tenantId])
  @@map("agenda_recorrencias")
}

/// "Visto/dispensado" pelo usuário para eventos de agenda-geral que não têm
/// um campo de conclusão real no registro de origem (exame ocupacional,
/// férias, desligamento) — não altera o registro de origem, só tira o
/// evento da lista de agenda para quem dispensou.
model AgendaDismissal {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  origem    String
  sourceId  String   @db.Uuid
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, origem, sourceId])
  @@map("agenda_dismissals")
}

model NotepadEntry {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  data      DateTime @db.Date
  conteudo  String   @default("")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, data])
  @@map("notepad_entries")
}

/// "Daily shutdown" (spec §6.9) — reflexão/observação de fim de dia por
/// usuário. Concluídos/pendentes do dia não ficam aqui, são derivados de
/// AgendaItem direto no frontend (GET /agenda/items?data=).
model AgendaRevisaoDiaria {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  data      DateTime @db.Date
  reflexao  String   @default("")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, data])
  @@map("agenda_revisoes_diarias")
}

// ─────────────────────────────────────────────────────────────
// SST — Saúde e Segurança do Trabalho
// ─────────────────────────────────────────────────────────────

enum AccidentTipo {
  TIPICO
  TRAJETO
  DOENCA_OCUPACIONAL

  @@map("accident_tipo")
}

enum AccidentStatus {
  EM_ANALISE
  ENCERRADA

  @@map("accident_status")
}

model Accident {
  id               String         @id @default(uuid()) @db.Uuid
  tenantId         String         @db.Uuid
  employeeId       String         @db.Uuid
  cargo            String
  tipoAcidente     AccidentTipo
  comAfastamento   Boolean        @default(false)
  diasAfastamento  Int            @default(0)
  dataAcidente     DateTime       @db.Date
  dataEmissaoCat   DateTime       @db.Date
  descricao        String?
  status           AccidentStatus @default(EM_ANALISE)
  esocialSent      Boolean        @default(false)
  causaRaiz        String?
  acaoCorretiva    String?
  notaEncerramento String?
  createdAt        DateTime       @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("accidents")
}

enum ExameTipo {
  ADMISSIONAL
  PERIODICO
  RETORNO_TRABALHO
  MUDANCA_FUNCAO
  DEMISSIONAL

  @@map("exame_tipo")
}

enum ExameResultado {
  APTO
  INAPTO

  @@map("exame_resultado")
}

model OccupationalExam {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @db.Uuid
  employeeId    String          @db.Uuid
  cargo         String
  tipo          ExameTipo
  dataPrevista  DateTime        @db.Date
  dataRealizada DateTime?       @db.Date
  resultado     ExameResultado?
  esocialSent   Boolean         @default(false)
  createdAt     DateTime        @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("occupational_exams")
}

model NrTrainingRecord {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  employeeId     String   @db.Uuid
  curso          String
  dataRealizacao DateTime @db.Date
  validadeMeses  Int      @default(12)
  createdAt      DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("nr_training_records")
}

enum PgrActionStatus {
  PLANEJADA
  EM_ANDAMENTO
  CONCLUIDA

  @@map("pgr_action_status")
}

model PgrAction {
  id       String          @id @default(uuid()) @db.Uuid
  tenantId String          @db.Uuid
  acao     String
  setor    String
  prazo    DateTime        @db.Date
  status   PgrActionStatus @default(PLANEJADA)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("pgr_actions")
}

enum RiskLevel {
  ALTO
  MEDIO
  BAIXO

  @@map("risk_level")
}

model RiskMapEntry {
  id       String    @id @default(uuid()) @db.Uuid
  tenantId String    @db.Uuid
  setor    String
  riscos   String
  nivel    RiskLevel

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("risk_map_entries")
}

/// Peso de impacto (1-5) por tipo de nao conformidade, usado pelo motor de
/// calculo de Risco Geral (RiskEngineService). Semeado por tenant a partir de
/// risk-weights.ts no signup (mesmo padrao de CLT_DOCUMENT_REQUIREMENTS), mas
/// vive na tabela -- nao no codigo -- para poder ser editado sem deploy e,
/// futuramente, configurado por cliente (apetite de risco varia por setor).
model RiskImpactRule {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  categoria String // DP | SST | Compliance | Psicologia
  tipo      String // chave estavel, ex: 'documentacao_cadastro_zero_conforme'
  impacto   Int // 1-5 -- peso fixo por tipo, nao calculado
  label     String
  ativo     Boolean  @default(true)
  sistema   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, tipo])
  @@index([tenantId])
  @@map("risk_impact_rules")
}

model SstSettings {
  tenantId                String    @id @db.Uuid
  mapaRiscosEsocialSentAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("sst_settings")
}

// ─────────────────────────────────────────────────────────────
// Documentos obrigatórios — motor de conformidade documental
// ─────────────────────────────────────────────────────────────

model DocumentRequirement {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @db.Uuid
  nome               String
  categoria          String
  obrigatorio        Boolean  @default(true)
  // Semeado automaticamente (documentos exigidos pela CLT) — não pode ser excluído.
  sistema            Boolean  @default(false)
  // Dias de validade a partir da data de conformidade; null = não expira.
  validadeDias       Int?
  // Listas vazias = aplica a todos; caso contrário, o valor do colaborador
  // precisa constar na lista para o requisito se aplicar a ele.
  aplicaStatus       String[] @default([])
  aplicaTipoContrato String[] @default([])
  aplicaDepartamento String[] @default([])
  aplicaCargo        String[] @default([])
  ativo              Boolean  @default(true)
  createdAt          DateTime @default(now())

  tenant    Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees EmployeeDocumentRequirement[]

  @@index([tenantId])
  @@map("document_requirements")
}

enum DocumentReqStatus {
  MISSING
  PENDING
  COMPLIANT
  EXPIRED
  REJECTED
  NAO_SE_APLICA

  @@map("document_req_status")
}

model EmployeeDocumentRequirement {
  id            String            @id @default(uuid()) @db.Uuid
  employeeId    String            @db.Uuid
  requirementId String            @db.Uuid
  status        DocumentReqStatus @default(MISSING)
  expiraEm      DateTime?
  observacao    String?
  arquivoNome   String?
  blobPathname  String?
  contentType   String?
  anexadoEm     DateTime?
  updatedAt     DateTime          @updatedAt

  employee    Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  requirement DocumentRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([employeeId, requirementId])
  @@index([employeeId])
  @@map("employee_document_requirements")
}

// ─────────────────────────────────────────────────────────────
// Tarefas — alertas do painel persistidos como itens acionáveis
// ─────────────────────────────────────────────────────────────

enum TaskPriority {
  BAIXA
  MEDIA
  ALTA
  CRITICA

  @@map("task_priority")
}

enum TaskStatus {
  ABERTA
  CONCLUIDA

  @@map("task_status")
}

model Task {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @db.Uuid
  modulo         String
  titulo         String
  prioridade     TaskPriority @default(MEDIA)
  status         TaskStatus   @default(ABERTA)
  // SISTEMA = gerada automaticamente a partir de uma regra do dashboard
  // (reaberta se a condição persistir); MANUAL = criada por um usuário.
  origem         String       @default("SISTEMA")
  alertKey       String?
  prazo          DateTime?
  assignedUserId String?      @db.Uuid
  detalhes       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, alertKey])
  @@index([tenantId, status])
  @@map("tasks")
}

/**
 * Fixação manual no widget "Tarefas do dia" — item combinado de Task
 * (alerta/manual) ou AgendaItem, sobrepondo a pontuação automática e
 * indo pro topo da lista. Tabela própria (em vez de um campo em cada
 * origem) porque o widget combina fontes de tabelas diferentes sob um
 * único conceito de fixação, por usuário.
 */
model TarefaDoDiaFixacao {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  origem    String // 'TASK' | 'AGENDA'
  origemId  String   @db.Uuid
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, origem, origemId])
  @@index([tenantId, userId])
  @@map("tarefas_do_dia_fixacoes")
}

// ─────────────────────────────────────────────────────────────
// Licenciamento — plano comercial por tenant
// ─────────────────────────────────────────────────────────────

// Catálogo global de planos comerciais — não é dado de tenant, sem RLS.
model LicensePlan {
  id               String   @id @default(uuid()) @db.Uuid
  code             String   @unique
  nome             String
  descricao        String?
  modulos          String[] @default([])
  maxUsuarios      Int
  maxColaboradores Int
  ativo            Boolean  @default(true)
  createdAt        DateTime @default(now())

  tenantLicenses TenantLicense[]

  @@map("license_plans")
}

enum TenantLicenseStatus {
  TRIAL
  ATIVA
  SUSPENSA
  CANCELADA
  EXPIRADA

  @@map("tenant_license_status")
}

model TenantLicense {
  tenantId         String              @id @db.Uuid
  planId           String              @db.Uuid
